# Salin file ini menjadi .env lalu isi key Anthropic kamu sendiri.
# Jangan commit file .env.
ANTHROPIC_API_KEY=
PORT=10100
WEB_ORIGIN=http://localhost:5174
# Kosongkan untuk otomatis: tanpa key = demo, dengan key = AI.
# Isi "demo" untuk memaksa mode demo walau key ada (misal saat presentasi).
AGENT_MODE=

# Otak Sparta (tab Chat). Kosongkan kalau perintah "claude" sudah ada di PATH.
# Kalau belum, isi path lengkap ke claude.exe, misal:
# CLAUDE_CODE_PATH=C:\Users\<nama>\.local\bin\claude.exe
CLAUDE_CODE_PATH=
